# Bind locally. Caddy/Nginx should be the only public listener.
PORT=8787
RELAY_BIND_HOST=127.0.0.1
RELAY_REQUIRE_TLS=1

# One or more channel/token pairs. Keep this file root-readable only.
# Replace this with a generated value before starting the service.
RELAY_PAIRINGS_JSON='{"replace-me":"replace-with-a-long-random-token"}'

# Persist only pairing/activity-token state, never chat content.
RELAY_STATE_PATH=/var/lib/opencodex-relay/state.json

# Optional ActivityKit push provider configuration.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.aitabby.opencodex.mobile
# APNS_PRIVATE_KEY_PATH=/etc/opencodex-relay/AuthKey_XXXXXXXXXX.p8
# APNS_ENV=production
